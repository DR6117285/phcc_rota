<?xml version="1.0" encoding="UTF-8"?>
<development-standards>
    <core-principles>
        <solid-principles>
            <principle name="Single-Responsibility">One purpose per module/class</principle>
            <principle name="Open-Closed">Extend, don't modify</principle>
            <principle name="Liskov-Substitution">Consistent inheritance</principle>
            <principle name="Interface-Segregation">Minimal interfaces</principle>
            <principle name="Dependency-Inversion">Depend on abstractions</principle>
        </solid-principles>
        
        <additional-principles>
            <principle name="TDD">Write tests first, then code</principle>
            <principle name="DRY">Extract common logic, use composables</principle>
            <principle name="KISS">Clear, straightforward solutions</principle>
            <principle name="YAGNI">Build only what's needed</principle>
            <principle name="Clean-Code">Prioritize readability and maintainability</principle>
            <principle name="Error-Handling">Implement robust error handling and logging</principle>
        </additional-principles>
    </core-principles>

    <code-standards>
        <organization>
            <rule>Files under 250 lines</rule>
            <rule>Code should be highly modular</rule>
            <rule>Clear separation of concerns</rule>
            <rule>Lines under 100 characters</rule>
            <rule>Automated formatting</rule>
            <rule>Framework-appropriate patterns</rule>
        </organization>

        <naming-conventions>
            <convention type="Directories">lowercase-dashed</convention>
            <convention type="Components">PascalCase</convention>
            <convention type="Utilities">camelCase</convention>
            <convention type="Variables">snake_case</convention>
            <convention type="Classes">PascalCase</convention>
            <convention type="Functions">camelCase</convention>
        </naming-conventions>

        <quality-controls>
            <control>Strong typing throughout</control>
            <control>Explicit function returns</control>
            <control>Comprehensive error handling</control>
            <control>Clear documentation</control>
            <control>Automated testing</control>
            <control>Regular security audits</control>
        </quality-controls>
    </code-standards>

    <testing>
        <tdd-workflow>
            <phase name="Red">
                <step>Write failing test first</step>
                <step>Test should clearly describe expected behavior</step>
                <step>Run test to verify it fails</step>
            </phase>
            <phase name="Green">
                <step>Write minimal code to pass test</step>
                <step>Focus on functionality, not optimization</step>
                <step>Run test to verify it passes</step>
            </phase>
            <phase name="Refactor">
                <step>Improve code structure</step>
                <step>Maintain test passing status</step>
                <step>Apply design patterns and principles</step>
            </phase>
        </tdd-workflow>

        <test-coverage>
            <requirement path="Critical">100%</requirement>
            <requirement path="Business-Logic">90%+</requirement>
            <requirement path="Overall">80%+</requirement>
        </test-coverage>
    </testing>

    <security>
        <authentication>
            <requirement>Secure session management</requirement>
            <requirement>Role-based access control</requirement>
            <requirement>Token-based authentication</requirement>
            <requirement>Password security standards</requirement>
            <requirement>2FA support where needed</requirement>
        </authentication>

        <data-protection>
            <measure>Input sanitization</measure>
            <measure>XSS/CSRF protection</measure>
            <measure>SQL injection prevention</measure>
            <measure>Content Security Policy</measure>
            <measure>Secure data transmission</measure>
            <measure>Environment variable usage</measure>
        </data-protection>
    </security>

    <version-control>
        <commit-standards>
            <type name="feat">New features</type>
            <type name="fix">Bug fixes</type>
            <type name="docs">Documentation</type>
            <type name="style">Formatting</type>
            <type name="refactor">Code changes</type>
            <type name="test">Adding tests</type>
            <type name="chore">Maintenance</type>
        </commit-standards>

        <branch-management>
            <practice>Feature branching</practice>
            <practice>Regular main updates</practice>
            <practice>Clean merge history</practice>
            <practice>Pull request reviews</practice>
            <practice>CI/CD integration</practice>
        </branch-management>
    </version-control>

    <task-management>
        <tracking>
            <component name="current-task">
                <field>Task identifier</field>
                <field>Status</field>
                <field>Owner</field>
                <field>Timeline</field>
                <field>Dependencies</field>
                <field>Blockers</field>
            </component>
            <component name="progress">
                <metric>Completion percentage</metric>
                <metric>Time tracking</metric>
                <metric>Resource utilization</metric>
            </component>
            <component name="documentation">
                <requirement>Technical specifications</requirement>
                <requirement>Implementation notes</requirement>
                <requirement>Performance metrics</requirement>
                <requirement>Known issues</requirement>
            </component>
        </tracking>

        <organization>
            <principle>Clean separation of concerns</principle>
            <principle>Hierarchical documentation</principle>
            <principle>Easy navigation</principle>
            <principle>Version control friendly</principle>
        </organization>
    </task-management>

    <project-structure>
        <source-code>
            <directory path="/src">
                <folder name="assets">Static assets</folder>
                <folder name="components">Framework components</folder>
                <folder name="modules">
                    <subfolder name="auth">Authentication</subfolder>
                    <subfolder name="database">Data access</subfolder>
                    <subfolder name="security">Security services</subfolder>
                    <subfolder name="analytics">Analytics processing</subfolder>
                </folder>
                <folder name="types">Type definitions</folder>
                <folder name="utils">Shared utilities</folder>
                <folder name="views">Page components</folder>
                <folder name="tests">Test files</folder>
            </directory>
        </source-code>

        <server>
            <directory path="/server">
                <folder name="instance">Database files</folder>
                <folder name="migrations">Database migrations</folder>
                <folder name="logs">Application logs</folder>
            </directory>
        </server>

        <documentation>
            <directory path="/docs">
                <folder name="current-task">Task tracking</folder>
                <folder name="components">Component documentation</folder>
                <folder name="architecture">System design</folder>
                <folder name="apis">API documentation</folder>
                <folder name="testing">Test documentation</folder>
            </directory>
        </documentation>
    </project-structure>

    <ci-cd>
        <continuous-integration>
            <check>Automated test runs</check>
            <scheck>Code quality checks</check>
            <check>Security scans</check>
            <check>Build verification</check>
            <check>Coverage reports</check>
        </continuous-integration>

        <continuous-deployment>
            <feature>Automated deployments</feature>
            <feature>Environment promotion</feature>
            <feature>Rollback capability</feature>
            <feature>Feature flags</feature>
            <feature>Monitoring alerts</feature>
        </continuous-deployment>
    </ci-cd>
</development-standards>